{
  "name": "@johngw/stream-mono-repo",
  "version": "2.2.0",
  "description": "Reactive programming tools using the WHATWG Streams API.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "stream",
    "streams",
    "whatwg streams",
    "stream api",
    "reactive"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:docs": "bun run build:docs:api && bun run build:docs:site",
    "build:docs:api": "typedoc",
    "build:docs:site": "bundle exec jekyll build --config jekyll.yml",
    "clean": "bun run build --clean",
    "lint": "oxlint",
    "prepare": "husky",
    "scaffold": "bun run node_modules/.bin/plop --plopfile=scaffold/plopfile.ts",
    "serve:docs": "bun run build:docs:api && concurrently --names api,site 'bun run build:docs:api --preserveWatchOutput --watch' 'bundle exec jekyll serve --config jekyll.yml'",
    "start": "bun run build --watch",
    "test": "bun --workspaces run test"
  },
  "catalog": {
    "@types/bun": "latest",
    "assert-never": "1.4.0",
    "rimraf": "6.1.2",
    "tslib": "2.8.1",
    "ts-toolbelt": "9.6.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "@commitlint/types": "20.3.1",
    "@types/bun": "catalog:",
    "concurrently": "^9.2.1",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "oxlint": "^1.41.0",
    "plop": "^4.0.5",
    "prettier": "3.8.1",
    "typedoc": "0.28.16",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{md,json,js,jsx,ts,tsx,yml,yaml}": [
      "bunx prettier --ignore-path .gitignore --write"
    ]
  }
}
