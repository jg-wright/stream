{
  "name": "@johngw/stream-mono-repo",
  "version": "2.2.0",
  "description": "Reactive programming tools using the WHATWG Streams API.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "stream",
    "streams",
    "whatwg streams",
    "stream api",
    "reactive"
  ],
  "scripts": {
    "build": "bun --workspaces run build",
    "build:docs": "bun run build:docs:api && bun run build:docs:site",
    "build:docs:api": "typedoc",
    "build:docs:site": "bundle exec jekyll build --config jekyll.yml",
    "clean": "bun --workspaces run clean",
    "prepare": "husky install",
    "serve:docs": "bun run build:docs:api && concurrently --names api,site 'bun run build:docs:api --preserveWatchOutput --watch' 'bundle exec jekyll serve --config jekyll.yml'"
  },
  "packageManager": "yarn@4.0.2",
  "catalog": {
    "@types/bun": "latest",
    "assert-never": "1.4.0",
    "rimraf": "5.0.5",
    "tslib": "2.8.1",
    "ts-toolbelt": "9.6.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@commitlint/cli": "18.4.3",
    "@commitlint/config-conventional": "18.4.3",
    "@commitlint/types": "18.4.3",
    "@types/bun": "catalog:",
    "concurrently": "^9.2.1",
    "husky": "8.0.3",
    "lint-staged": "15.2.0",
    "prettier": "2.8.8",
    "typedoc": "0.25.6",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{md,json,js,jsx,ts,tsx,yml,yaml}": [
      "bunx prettier --ignore-path .gitignore --write"
    ]
  }
}
