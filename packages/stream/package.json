{
  "name": "@johngw/stream",
  "version": "3.1.0",
  "type": "module",
  "description": "Reactive programming tools using the WHATWG Streams API.",
  "keywords": [
    "stream",
    "streams",
    "whatwg streams",
    "stream api",
    "reactive"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "coverage": "open coverage/lcov-report/index.html",
    "start": "tsc --watch --preserveWatchOutput",
    "test": "bun test"
  },
  "exports": {
    ".": "./dist/index.js",
    "./sinks": "./dist/sinks/index.js",
    "./sinks/*": "./dist/sinks/*.js",
    "./sources": "./dist/sources/index.js",
    "./sources/*": "./dist/sources/*.js",
    "./storages": "./dist/storages/index.js",
    "./storages/*": "./dist/storages/*.js",
    "./subjects": "./dist/subjects/index.js",
    "./subjects/*": "./dist/subjects/*.js",
    "./transformers": "./dist/transformers/index.js",
    "./transformers/*": "./dist/transformers/*.js",
    "./types": "./dist/types/index.js",
    "./types/*": "./dist/types/*.js"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.3.4",
    "@johngw/stream-test": "workspace:*",
    "@johngw/stream-test-bun": "workspace:*",
    "@types/bun": "catalog:",
    "@types/jsdom": "^27.0.0",
    "jsdom": "^27.4.0",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@johngw/stream-common": "workspace:*",
    "assert-never": "catalog:",
    "ts-toolbelt": "catalog:",
    "tslib": "catalog:"
  }
}
