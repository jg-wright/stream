{
  "name": "@johngw/stream-test",
  "version": "2.2.3",
  "description": "Testing utilities for streams",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --build",
